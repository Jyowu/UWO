// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// Radial profiles at z/D = 0.5, 1, 3 downstream of expansion
// Inlet at z = -2D = -0.10156 m,  expansion at z = 0
// D = 0.05078 m,  R_outer = 1.94*D/2 = 0.04926 m
// Full diameter traverse: start(-R2) to end(+R2) along x at y=0
// R2 = D2/2 = 1.94*D/2 = 0.04926 m
// Utheta = sign(x)*Uy,  Uz = axial (symmetric)

type            sets;
libs            ("libsampling.so");

writeControl    writeTime;

setFormat       raw;
interpolationScheme cellPoint;

fields          ( U );

sets
(
    r_zD0p5
    {
        type        lineUniform;
        axis        x;
        start       ( -0.049  0  0.02539 );
        end         (  0.049  0  0.02539 );
        nPoints     200;
    }

    r_zD1
    {
        type        lineUniform;
        axis        x;
        start       ( -0.049  0  0.05078 );
        end         (  0.049  0  0.05078 );
        nPoints     200;
    }

    r_zD3
    {
        type        lineUniform;
        axis        x;
        start       ( -0.049  0  0.15234 );
        end         (  0.049  0  0.15234 );
        nPoints     200;
    }
);


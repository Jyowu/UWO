FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      physicalProperties.water;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

viscosityModel  constant;

nu              8.0e-7;     // Re=30000, U=0.473, D=0.05078 → nu=U*D/Re

rho             996;



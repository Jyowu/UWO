FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// omega = k^0.5 / (Cmu^0.25 * l) = 0.02553 / (0.5477 * 0.003555) = 13.1 s^-1

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform 13.1;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 13.1;
    }
    outlet
    {
        type            zeroGradient;
    }
    walls
    {
        type            omegaWallFunction;
        value           uniform 13.1;
    }
}

